generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tabela de Usuários (Responsáveis)
model User {
  id           String   @id @default(uuid())
  name         String   @map("nome")
  email        String   @unique
  passwordHash String   @map("senha_hash")
  gender       String   @map("sexo")
  birthDate    DateTime @map("data_nascimento")
  avatarUrl    String?  @map("img_url")

  children     UserChild[]

  categories   Category[]

  @@map("users")
}

// Tabela de Filhos
model Child {
  id              String   @id @default(uuid())
  name            String   @map("nome")
  avatarUrl       String?  @map("img_url")
  birthDate       DateTime @map("data_nascimento")
  supportLevel    Int      @map("nivel_suporte")
  notes           String?  @map("observacoes")

  guardians       UserChild[]
  tasks           Task[]
  technicalInfos  TechnicalInfo[]
  writtenNotes    Note[]

  @@map("children")
}

// Tabela Pivô (Filho_Responsavel)
model UserChild {
  userId  String @map("usuario_id")
  childId String @map("filho_id")

  role    String @default("ADMIN") @map("funcao")

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([userId, childId])
  @@map("filho_responsavel")
}

// Tabela de Categorias
model Category {
  id     String @id @default(uuid())
  name   String @map("nome")
  color  String @map("cor")
  userId String @map("usuario_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks  Task[]

  @@map("categories")
}

// Tabela de Tarefas
model Task {
  id             String    @id @default(uuid())
  name           String    @map("nome")
  imgUrl         String?   @map("img_url")
  time           String    @map("hora") // Vamos usar String "14:30" (SQLite não tem Time puro)
  notes          String?   @map("observacoes")
  status         String    @default("PENDENTE") // PENDENTE, CONCLUIDO
  recurrenceType String    @map("recorrencia_tipo") // "DIARIO", "SEMANAL", "UNICO"
  singleDate     DateTime? @map("data_unica")
  recurrenceEnds DateTime? @map("recorrencia_ate")

  childId      String    @map("filho_id")
  categoryId   String?   @map("categoria_id") // Opcional, caso possa criar sem categoria

  // Relacionamentos
  child        Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  category     Category? @relation(fields: [categoryId], references: [id])
  
  days         TaskDay[]

  @@map("tasks")
}

// Tabela Tarefa_Recorrencia_Dia
model TaskDay {
  id     String @id @default(uuid())
  day    String @map("dia")
  taskId String @map("tarefa_id")

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_recurrence_days")
}

// Tabela Filho_Informacao_Tecnica
model TechnicalInfo {
  id          String   @id @default(uuid())
  type        String   @map("tipo") // Ex: "alergia", "gatilho"
  description String   @map("descricao")
  createdAt   DateTime @default(now()) @map("criado_em")
  
  childId     String   @map("filho_id")
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("filho_informacao_tecnica")
}

// Tabela de Anotações
model Note {
  id        String   @id @default(uuid())
  childId   String   @map("filho_id")
  type      String   @map("tipo") // Ex: "diario", "ocorrencia"
  text      String   @map("texto")
  mediaUrl  String?  @map("media_url") // Opcional (fotos/audio)
  createdAt DateTime @default(now()) @map("criado_em")

  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("anotacoes")
}